{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "America/New_York",
  "minimumReleaseAge": "3 days",
  "schedule": ["* 6-10 * * 1"],
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchPackageNames": ["@ionic/**"],
      "minimumReleaseAge": "0 days",
      "groupName": "ionic"
    },
    {
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**",
        "@angular-eslint/**",
        "angular-eslint",
        "typescript"
      ],
      "groupName": "angular",
      "schedule": ["* 6-10 1 * *"]
    },
    {
      "matchPackageNames": ["@capacitor/**"],
      "groupName": "capacitor"
    },
    {
      "matchPackageNames": ["@awesome-cordova-plugins/**"],
      "groupName": "awesome-cordova-plugins"
    },
    {
      "matchPackageNames": ["leaflet", "@types/leaflet"],
      "groupName": "leaflet"
    },
    {
      "matchPackageNames": [
        "karma*",
        "jasmine*",
        "@types/jasmine",
        "puppeteer"
      ],
      "groupName": "testing"
    },
    {
      "matchPackageNames": ["eslint", "@eslint/**", "stylelint*", "typescript-eslint"],
      "groupName": "dev-tools"
    }
  ]
}
