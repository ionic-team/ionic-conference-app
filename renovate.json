{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "description": "Renovate may only open or update PRs on Mondays, 6-10am ET.",
  "timezone": "America/New_York",
  "minimumReleaseAge": "3 days",
  "schedule": ["* 6-10 * * 1"],
  "semanticCommits": "enabled",
  "ignorePaths": ["android/**", "ios/**"],
  "gitIgnoredAuthors": ["hi@ionicframework.com"],
  "packageRules": [
    {
      "matchPackageNames": ["@ionic/**", "!@ionic/eslint-config", "!@ionic/prettier-config"],
      "minimumReleaseAge": "0 days",
      "groupName": "ionic"
    },
    {
      "description": "Angular majors land on a fixed cadence, so this group is restricted to the 1st of each month, 6-10am ET.",
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**",
        "@angular-eslint/**",
        "angular-eslint",
        "typescript"
      ],
      "groupName": "angular",
      "schedule": ["* 6-10 1 * *"]
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0",
      "description": "Angular 22 requires typescript >=6.0 <6.1. Raise this when Angular widens its typescript range."
    },
    {
      "matchPackageNames": ["@capacitor/**"],
      "groupName": "capacitor"
    },
    {
      "matchPackageNames": ["leaflet", "@types/leaflet"],
      "groupName": "leaflet"
    },
    {
      "matchPackageNames": ["vitest", "jsdom", "@playwright/test", "puppeteer"],
      "groupName": "testing"
    },
    {
      "matchPackageNames": ["vitest"],
      "allowedVersions": "<6.0.0",
      "description": "@angular/build supports vitest ^4.0.8 || ^5.0.0. Raise this when Angular widens its vitest range."
    },
    {
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "@ionic/eslint-config",
        "@ionic/prettier-config",
        "prettier",
        "stylelint*",
        "typescript-eslint"
      ],
      "groupName": "dev-tools"
    },
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25",
      "description": "Keep Node's types on the major version CI runs (24)"
    }
  ]
}
