{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":semanticCommitTypeAll(chore)"],
  "minimumReleaseAge": "3 days",
  "schedule": ["every weekday before 11am"],
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchPackageNames": ["@ionic/**"],
      "minimumReleaseAge": "0 days",
      "groupName": "ionic"
    },
    {
      "matchPackageNames": ["@angular/**", "@angular-devkit/**", "@angular-eslint/**"],
      "groupName": "angular",
      "schedule": ["on the first day of the month"]
    },
    {
      "matchPackageNames": ["@capacitor/**"],
      "groupName": "capacitor"
    },
    {
      "matchPackageNames": ["karma", "jasmine", "puppeteer", "@types/**"],
      "groupName": "testing"
    },
    {
      "matchPackageNames": ["eslint", "stylelint", "typescript"],
      "groupName": "dev-tools"
    }
  ]
}
