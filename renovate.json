{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "description": "Renovate may only open or update PRs on Mondays, 6-10am ET.",
  "timezone": "America/New_York",
  "minimumReleaseAge": "3 days",
  "schedule": ["* 6-10 * * 1"],
  "semanticCommits": "enabled",
  "ignorePaths": ["android/**", "ios/**"],
  "packageRules": [
    {
      "matchPackageNames": ["@ionic/**"],
      "minimumReleaseAge": "0 days",
      "groupName": "ionic"
    },
    {
      "description": "Angular majors land on a fixed cadence, so this group is restricted to the 1st of each month, 6-10am ET.",
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**",
        "@angular-eslint/**",
        "angular-eslint",
        "typescript"
      ],
      "groupName": "angular",
      "schedule": ["* 6-10 1 * *"]
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0",
      "description": "Angular 22 requires typescript >=6.0 <6.1. Raise this when Angular widens its typescript range."
    },
    {
      "matchPackageNames": ["@capacitor/**"],
      "groupName": "capacitor"
    },
    {
      "matchPackageNames": ["@awesome-cordova-plugins/**"],
      "groupName": "awesome-cordova-plugins"
    },
    {
      "matchPackageNames": ["leaflet", "@types/leaflet"],
      "groupName": "leaflet"
    },
    {
      "matchPackageNames": [
        "karma*",
        "jasmine*",
        "@types/jasmine",
        "puppeteer"
      ],
      "groupName": "testing"
    },
    {
      "matchPackageNames": ["jasmine-core", "@types/jasmine"],
      "allowedVersions": "<7.0.0",
      "description": "@types/jasmine has no 7.x release. Raise this when it publishes one."
    },
    {
      "matchPackageNames": ["eslint", "@eslint/**", "stylelint*", "typescript-eslint"],
      "groupName": "dev-tools"
    }
  ]
}
