{
  "name": "ionic-angular-conference-app",
  "version": "0.0.0",
  "description": "Ionic Conference App",
  "author": "Ionic Team <hi@ionicframework.com>",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "lint": "npm run eslint && npm run lint:sass && npm run typecheck:e2e && npm run prettier -- --check",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint:sass": "stylelint \"src/**/*.scss\"",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ionic-team/ionic-conference-app.git"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/pwa": "^22.2.4",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/angular": "^9.0.0",
    "@ionic/storage-angular": "^4.0.0",
    "core-js": "^3.6.4",
    "leaflet": "^1.9.4",
    "rxjs": "^7.8.0",
    "sw-toolbox": "3.6.0",
    "tslib": "^2.0.0",
    "wait-on": "^7.0.1",
    "webdriver-manager": "12.1.9"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.4",
    "@angular-devkit/core": "^22.2.4",
    "@angular-devkit/schematics": "^22.2.4",
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@capacitor/cli": "^8.0.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "7.2.1",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/storage": "^3.0.6",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^24.19.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "puppeteer": "^11.0.0",
    "stylelint": "15.11.0",
    "stylelint-config-standard-scss": "7.0.1",
    "stylelint-order": "6.0.4",
    "ts-node": "8.10.2",
    "typescript": "~6.0.3",
